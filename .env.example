# Copy to .env at the repository root and fill in. Never commit .env.
# The API, the worker, the seed and the web app all read this one file.

# Database. The direct db.<ref>.supabase.co host is IPv6 only; the API
# rewrites it to the session pooler below, so either form works here.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_POOL_MAX=3
# Path to the Supabase root CA (Dashboard > Database > SSL); when set, the server certificate is verified.
DB_SSL_CA=

# Supabase project (server side). The secret key never reaches the browser.
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_JWKS_URL=https://YOUR-REF.supabase.co/auth/v1/.well-known/jwks.json
RECORDINGS_BUCKET=recordings
AUDIO_RETENTION_DAYS=90
# Signs 5-minute batch export links. Required when more than one API process runs;
# generate with: openssl rand -hex 32
EXPORT_LINK_SECRET=
# Encrypts webhook signing secrets at rest (ADR-0021); 64 hex characters.
# Without it webhooks cannot be created. Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Vercel Cron sends it as a bearer token to /api/cron/* (ADR-0020); 32 or more
# characters. Unset, the cron routes refuse every call. openssl rand -hex 32
CRON_SECRET=

# Model gateway. Groq is the default provider; OpenRouter and Gemini are chat only.
GROQ_API_KEY=gsk_REPLACE_ME
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3
TTS_MODEL=canopylabs/orpheus-v1-english
# Sarvam AI: speech-to-text and translation for Indian-language calls (ADR-0014).
SARVAM_API_KEY=sk_REPLACE_ME
STT_REGIONAL_MODEL=saaras:v4
TRANSLATE_MODEL=sarvam-translate:v1
# Requests per minute for each Sarvam model; raise to your account's limit.
LIMIT_SARVAM_RPM=20
# Monthly spend cap in USD; the gateway refuses calls once it is reached.
LLM_BUDGET_USD=5
# live: real calls; record: real calls saved as cassettes; replay: cassettes only.
MODEL_MODE=live

# API process
PORT=8080
LOG_LEVEL=info
LOG_PRETTY=true
WEB_ORIGIN=http://localhost:5173
WORKER_CONCURRENCY=1
# Queue system for background jobs (ADR-0032): pgboss (Postgres, local and Docker) or vercel
# (Vercel Queues, on Vercel only; set it for the build too). Adapters live in apps/api/src/jobs/adapters.
JOB_QUEUE=pgboss

# Web app (public: every VITE_ value is inlined into the bundle).
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://YOUR-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Extra sign-in buttons, comma separated: google, azure (Microsoft), saml.
# Each must be enabled in Supabase Auth first (docs/runbooks/sso.md).
VITE_AUTH_PROVIDERS=
