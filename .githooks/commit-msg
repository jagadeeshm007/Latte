#!/usr/bin/env bash
# commit-msg: Conventional Commit subject, task id present on task branches,
# and the optional rules in lib.sh's policy block (AI trailer, em dash, body
# width). pre-push runs the same check on every commit it sends.
HOOK_NAME=commit-msg
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || hook_fail "usage: commit-msg <message file>"
branch="$(git branch --show-current 2>/dev/null || true)"
problem="$(message_problem "$msg_file" "$(task_of "$branch")")" || hook_fail "$problem"
hook_note "1 message checked"
exit 0
