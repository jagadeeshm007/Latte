# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug
# Pretty logs are a development convenience; production logs are JSON lines.
LOG_PRETTY=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales-call-platform
DB_POOL_MAX=10
SHUTDOWN_TIMEOUT_MS=10000
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
