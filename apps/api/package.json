{
  "name": "@scc/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed:reset-passwords": "tsx --env-file-if-exists=../../.env src/seed.ts --reset-passwords",
    "env:check": "tsx --env-file-if-exists=../../.env src/env-check.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@scc/gateway": "workspace:*",
    "@scc/shared": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "express": "5.3.0",
    "jose": "6.2.12",
    "mpg123-decoder": "1.0.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "tsx": "4.23.15",
    "wavefile": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  },
  "exports": {
    "./scoring": "./src/scoring/score.ts",
    "./transcribe": "./src/audio/transcribe.ts",
    "./wav": "./src/audio/wav.ts",
    "./decode": "./src/audio/decode.ts"
  }
}
